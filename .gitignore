# Private local settings (only examples and the public station catalogue belong in Git)
/config/*
!/config/.gitignore
!/config/*.example
!/config/stations.json
.env
.env.*
!.env.example
*.key
*.pem
credentials*.json
secrets*.json

# User data, generated reports, download caches, logs and backups
/input/*
!/input/.gitignore
!/input/README.txt
/output/
*.log
*.tmp
*.partial

# Local Python environment and generated bytecode
/.packages/
/.venv/
/venv/
/env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
/build/
/dist/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
