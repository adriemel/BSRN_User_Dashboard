[ftp]
host = ftp.bsrn.awi.de
protocol = ftps-control
remote_root = /
user = YOUR_BSRN_USERNAME
password = YOUR_BSRN_PASSWORD
timeout_seconds = 120
download_workers = 3

# BSRN_FTP_USER and BSRN_FTP_PASSWORD override these credentials.
# Keep the real bsrn_workflow.ini private. Workers are bounded to 1–4.
